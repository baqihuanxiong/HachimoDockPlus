{
  "data_dir": ".local/data",
  "audio": {
    "capture_device": "default",
    "playback_device": "default",
    "mixer_card": "Device",
    "volume": 60,
    "output": "speaker",
    "spdif_device": "iec958:CARD=Device,DEV=0",
    "bluetooth_device": ""
  },
  "ui": {
    "app_order": ["picoclaw", "settings", "music", "newapi-monitor"],
    "timezone": "Asia/Shanghai",
    "controls": {
      "disabled": false,
      "swap_xy": false,
      "invert_x": false,
      "invert_y": true
    },
    "framebuffer": "/dev/fb0",
    "input": "auto",
    "font": ".local/assets/wqy-microhei.ttc"
  },
  "apps": {
    "newapi-monitor": {
      "url": "https://your-newapi.example",
      "admin_id": 1,
      "key_file": ".local/secrets/newapi-admin.key",
      "top_n": 10,
      "reset_usd": 200,
      "refresh_seconds": 300,
      "providers": []
    },
    "picoclaw": {
      "extensions_dir": "agent",
      "llm": {
        "url": "https://your-model-service.example/v1",
        "model": "your-model",
        "key_file": ".local/secrets/llm.key"
      },
      "asr": {
        "url": "wss://your-asr-service.example",
        "key_file": ".local/secrets/asr.key",
        "language": "中文"
      },
      "tts": {
        "url": "https://your-tts-service.example",
        "key_file": ".local/secrets/tts.key",
        "mode": "instruct2",
        "prompt_wav": ".local/assets/reference.wav",
        "prompt_text": "",
        "instruction": "请用自然、清晰的中文说话。"
      }
    }
  }
}
