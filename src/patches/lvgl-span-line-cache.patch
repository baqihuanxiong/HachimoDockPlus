+/* Anchors are rebuilt with layout and invalidated by text/style/size changes.
+ * A partial index remains valid if allocation fails; drawing can scan its tail. */
+static void cache_line(lv_spangroup_t * spans, lv_span_t * span, uint32_t offset, int32_t y, const lv_snippet_t * snippet)
+{
+    if(spans->line_count == spans->line_capacity) {
+        uint32_t capacity = spans->line_capacity ? spans->line_capacity * 2 : 16;
+        lv_span_line_t * lines = lv_realloc(spans->line_cache, capacity * sizeof(*lines));
+        if(!lines) return;
+        spans->line_cache = lines;
+        spans->line_capacity = capacity;
+    }
+    spans->line_cache[spans->line_count++] = (lv_span_line_t){span, offset, y, snippet->span, snippet->font, snippet->letter_space, snippet->line_h};
+}
