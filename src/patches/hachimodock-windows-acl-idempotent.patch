+test("valid Windows entries remain usable when ACL writes are denied", { skip: process.platform !== "win32" }, async () => withDirectory(async dir => {
+  const { windowsAcl } = require("../src/adapters/windows-acl");
+  const { spawnSync } = require("node:child_process");
+  const file = path.join(dir, "acl-write-denied.json");
+  createCapabilityStore().writeDescriptor({ fixture: true }, file);
+  const before = fs.readFileSync(file);
+  const spawn = (executable, args, options) => {
+    const script = Buffer.from(args.at(-1), "base64").toString("utf16le");
+    const write = "Microsoft.PowerShell.Security\\Set-Acl -LiteralPath $name -AclObject $acl";
+    assert.equal(script.split(write).length, 2);
+    const injected = script.replace(write, "throw 'fixture ACL write denied'");
+    return spawnSync(executable, [...args.slice(0, -1), Buffer.from(injected, "utf16le").toString("base64")], options);
+  };
+  windowsAcl("prepare-directory", dir, { spawn });
+  windowsAcl("protect-file", file, { spawn });
+  windowsAcl("verify-file", file);
+  assert.deepEqual(fs.readFileSync(file), before);
+}));
